# Overlay LiveKit Cloud — copier vers .env.cloud et renseigner les secrets.
# Ne jamais committer .env.cloud ni exposer les clés côté client.

SHOW360_LIVEKIT_MODE=cloud
SHOW360_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
SHOW360_LIVEKIT_API_KEY=APIxxxxxxxx
SHOW360_LIVEKIT_API_SECRET=secret_xxxxxxxx
SHOW360_LIVEKIT_TOKEN_TTL=3600

SHOW360_API_BIND=0.0.0.0:8080
SHOW360_PUBLIC_BASE_URL=http://127.0.0.1:8080
RUST_LOG=info,show360_api=debug
