{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Show360",
  "version": "0.1.0",
  "identifier": "app.show360.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:8081",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Show360",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.png"
    ]
  }
}
